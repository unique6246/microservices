# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values before running
# NEVER commit the real .env file to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASS=changeme_db_password

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=changeme_rabbitmq_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASS=changeme_redis_password

# ── SMTP (Gmail example) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ISSUER_URI=http://localhost:9000

