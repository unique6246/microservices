                  "if (json.accountInfo && json.accountInfo.customerId) {",
                  "  pm.collectionVariables.set('customerId2', json.accountInfo.customerId);",
                  "  console.log('✅ customerId2 saved:', json.accountInfo.customerId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Smith\",\n  \"gender\": \"MALE\",\n  \"address\": \"22 Oak Avenue, New York\",\n  \"phoneNumber\": \"+11234567890\",\n  \"email\": \"bob.smith@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api","v1","customers"] }
          }
        },
        {
          "name": "1.3 Get Customer 1 by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('First name is Alice', () => pm.expect(json.firstName).to.eql('Alice'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/customers/{{customerId1}}", "host": ["{{baseUrl}}"], "path": ["api","v1","customers","{{customerId1}}"] }
          }
        },
        {
          "name": "1.4 List All Customers (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Content is a page', () => pm.expect(json).to.have.property('content'));"
                ]
