          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers?page=0&size=20",
              "host": ["{{baseUrl}}"], "path": ["api","v1","customers"],
              "query": [{ "key": "page","value": "0" }, { "key": "size","value": "20" }]
            }
          }
        }
      ]
