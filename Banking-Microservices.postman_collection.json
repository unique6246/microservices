{
  "info": {
    "name": "Banking Microservices — Full API Flow",
    "description": "Complete end-to-end flow: Auth → Customer → Account → Transactions → Notifications\n\nAll requests go through the API Gateway on http://localhost:8080\n\nRun in order — each step auto-saves IDs and tokens for the next step.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080" },
    { "key": "token",         "value": "" },
    { "key": "customerId1",   "value": "" },
    { "key": "customerId2",   "value": "" },
    { "key": "accountNumber1","value": "" },
    { "key": "accountNumber2","value": "" }
  ],
  "item": [

    {
      "name": "0 — Auth",
      "item": [
        {
          "name": "0.1 Get JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.access_token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token received', () => pm.expect(json.access_token).to.be.a('string'));",
                  "console.log('✅ Token saved:', json.access_token.substring(0,40) + '...');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"roles\": [\"USER\", \"ADMIN\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/token", "host": ["{{baseUrl}}"], "path": ["auth","token"] }
          }
        },
        {
          "name": "0.2 Verify Token Rejected Without Auth (401 check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api","v1","customers"] }
          }
        }
      ]
    },

    {
      "name": "1 — Customer Service",
      "item": [
        {
          "name": "1.1 Create Customer 1 (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "if (json.accountInfo && json.accountInfo.customerId) {",
                  "  pm.collectionVariables.set('customerId1', json.accountInfo.customerId);",
                  "  console.log('✅ customerId1 saved:', json.accountInfo.customerId);",
                  "}",
                  "pm.test('Response code present', () => pm.expect(json.responseCode).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Johnson\",\n  \"gender\": \"FEMALE\",\n  \"address\": \"10 Baker Street, London\",\n  \"phoneNumber\": \"+19876543210\",\n  \"email\": \"alice.johnson@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api","v1","customers"] }
          }
        },
        {
          "name": "1.2 Create Customer 2 (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
