    {
      "name": "09 â€” NEFT / RTGS / IMPS",
      "item": [
        {
          "name": "NEFT Transfer â‚¹5,000 (Free)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var body = pm.response.json();",
              "if (body.accountInfo && body.accountInfo.message) {",
              "  var match = body.accountInfo.message.match(/Reference: (TXN-[^ |]+)/);",
              "  if (match) pm.collectionVariables.set('referenceNo', match[1]);",
              "}"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/neft",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{accountNo}}\",\n  \"beneficiaryAccountNumber\": \"9876543210\",\n  \"beneficiaryName\": \"John Doe\",\n  \"ifscCode\": \"HDFC0001234\",\n  \"bankName\": \"HDFC Bank\",\n  \"amount\": 5000,\n  \"channel\": \"NEFT\",\n  \"remarks\": \"Rent payment\"\n}"
            }
          }
        },
        {
          "name": "RTGS Transfer â‚¹2,50,000 (â‚¹24 Fee)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/neft",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{accountNo}}\",\n  \"beneficiaryAccountNumber\": \"1111222233334444\",\n  \"beneficiaryName\": \"Corp Ltd\",\n  \"ifscCode\": \"ICIC0001111\",\n  \"bankName\": \"ICICI Bank\",\n  \"amount\": 250000,\n  \"channel\": \"RTGS\",\n  \"remarks\": \"Vendor payment\"\n}"
            }
          }
