{
  "info": {
    "name": "Banking Microservices â€” VM Testing",
    "_postman_id": "banking-vm-v3",
    "description": "Full API test collection for banking services on Kubernetes VM.\n\nQUICK START:\n1. Edit 'vmIp' variable below â€” set your VM's IP address\n2. Run '00 â€” Health Checks' to confirm all pods are up\n3. Run '01 â€” Get JWT Token' â€” token saves to {{token}} automatically\n4. Run folders 02 â†’ 03 â†’ ... in order\n\nAll requests use Bearer {{token}} automatically (collection-level auth).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "vmIp",       "value": "YOUR_VM_IP_HERE", "description": "CHANGE THIS â€” your VM IP e.g. 192.168.1.100" },
    { "key": "baseUrl",    "value": "http://{{vmIp}}:30080" },
    { "key": "token",      "value": "" },
    { "key": "accountNo",  "value": "" },
    { "key": "accountNo2", "value": "" },
    { "key": "customerId", "value": "1" },
    { "key": "customerId2","value": "2" },
    { "key": "loanId",     "value": "1" },
    { "key": "docId",      "value": "1" },
    { "key": "referenceNo","value": "" },
    { "key": "otp",        "value": "" }
  ],
  "item": [
    {
      "name": "00 â€” Health Checks (no auth required)",
      "item": [
        {
          "name": "Gateway Health",
          "request": { "auth": {"type":"noauth"}, "method": "GET", "url": "http://{{vmIp}}:30080/actuator/health" }
        },
        {
          "name": "Eureka UI  (open in browser: http://{{vmIp}}:30761)",
          "request": { "auth": {"type":"noauth"}, "method": "GET", "url": "http://{{vmIp}}:30761" }
        },
        {
          "name": "Zipkin UI  (open in browser: http://{{vmIp}}:30411)",
          "request": { "auth": {"type":"noauth"}, "method": "GET", "url": "http://{{vmIp}}:30411" }
        },
        {
          "name": "RabbitMQ Management  (open in browser: http://{{vmIp}}:31672)",
          "request": { "auth": {"type":"noauth"}, "method": "GET", "url": "http://{{vmIp}}:31672" }
        }
      ]
    },
    {
      "name": "01 â€” Get JWT Token",
      "item": [
        {
          "name": "POST /auth/token  â†’  auto-saves {{token}}",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var body = pm.response.json();",
                "if (body.access_token) {",
                "  pm.collectionVariables.set('token', body.access_token);",
                "  pm.test('Token received', () => pm.expect(body.access_token).to.be.a('string'));",
                "  console.log('JWT token saved â€” expires in 1h');",
                "} else {",
                "  console.error('ERROR: No token â€” check api-gateway pod logs');",
                "}"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://{{vmIp}}:30080/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"roles\": [\"USER\", \"ADMIN\"]\n}"
            }
          }
        },
        {
          "name": "Verify Token Works â€” GET /api/v1/accounts (expect 200)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/accounts" }
        }
      ]
    },
    {
      "name": "02 â€” Customer Management",
      "item": [
        {
          "name": "Create Customer 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ravi\",\n  \"lastName\": \"Kumar\",\n  \"gender\": \"MALE\",\n  \"address\": \"123 MG Road, Bengaluru\",\n  \"phoneNumber\": \"9876543210\",\n  \"email\": \"ravi.kumar@example.com\"\n}"
            }
          }
        },
        {
          "name": "Create Customer 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Sharma\",\n  \"gender\": \"FEMALE\",\n  \"address\": \"456 Link Road, Mumbai\",\n  \"phoneNumber\": \"9123456789\",\n  \"email\": \"priya.sharma@example.com\"\n}"
            }
          }
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/customers"
          }
        }
      ]
    },
    {
      "name": "02 â€” Account Management",
      "item": [
        {
          "name": "Create SAVINGS Account (â‚¹500 min-bal, 3.5% interest)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var body = pm.response.json();",
              "if (body.accountInfo && body.accountInfo.accountNumber) {",
              "  pm.collectionVariables.set('accountNo', body.accountInfo.accountNumber);",
              "  console.log('Set accountNo:', body.accountInfo.accountNumber);",
              "}"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"customerId\": {{customerId}},\n  \"nomineeName\": \"Jane Doe\"\n}"
            }
          }
        },
        {
          "name": "Create CURRENT Account (â‚¹10L daily limit)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var body = pm.response.json();",
              "if (body.accountInfo && body.accountInfo.accountNumber) {",
              "  pm.collectionVariables.set('accountNo2', body.accountInfo.accountNumber);",
              "}"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"CURRENT\",\n  \"customerId\": {{customerId2}}\n}"
            }
          }
        },
        {
          "name": "Create FIXED_DEPOSIT Account (7% interest)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"FIXED_DEPOSIT\",\n  \"customerId\": 3,\n  \"maturityDate\": \"2027-05-11\",\n  \"nomineeName\": \"Ravi Kumar\"\n}"
            }
          }
        },
        {
          "name": "Get Account by Account Number",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/account/{{accountNo}}"
          }
        },
        {
          "name": "Credit â‚¹50,000 to Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/credit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNo}}\",\n  \"amount\": 50000\n}"
            }
          }
        },
        {
          "name": "Close Account â€” Expect Fail (non-zero balance)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/accounts/{{accountNo}}"
          }
        }
      ]
    },
    {
      "name": "03 â€” Freeze & Unfreeze",
      "item": [
        {
          "name": "Freeze Account",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/freeze?reason=Suspicious+activity",
              "query": [{ "key": "reason", "value": "Suspicious activity" }]
            }
          }
        },
        {
          "name": "Debit Frozen Account â€” Expect Fail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/debit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNo}}\",\n  \"amount\": 100\n}"
            }
          }
        },
        {
          "name": "Unfreeze Account",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/unfreeze"
          }
        },
        {
          "name": "Unfreeze Active Account â€” Expect Fail",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/unfreeze"
          }
        }
      ]
    },
    {
      "name": "04 â€” Daily Transaction Limits",
      "item": [
        {
          "name": "Set Daily Limit to â‚¹5,000",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/limits?dailyLimit=5000",
              "query": [{ "key": "dailyLimit", "value": "5000" }]
            }
          }
        },
        {
          "name": "Debit â‚¹4,000 (within limit) â€” Should Pass",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/debit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNo}}\",\n  \"amount\": 4000\n}"
            }
          }
        },
        {
          "name": "Debit â‚¹2,000 More â€” Expect Fail (limit exceeded)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/debit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNo}}\",\n  \"amount\": 2000\n}"
            }
          }
        },
        {
          "name": "Breach Min Balance â€” Expect Fail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/debit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNo}}\",\n  \"amount\": 50000\n}"
            }
          }
        },
        {
          "name": "Reset Daily Limit to â‚¹1,00,000",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/limits?dailyLimit=100000",
              "query": [{ "key": "dailyLimit", "value": "100000" }]
            }
          }
        }
      ]
    },
    {
      "name": "05 â€” TPIN (4-digit PIN)",
