          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/pin/verify?pin=1234",
              "query": [{ "key": "pin", "value": "1234" }]
            }
          }
        },
        {
          "name": "Set PIN â€” Non-4-Digit â€” Expect Fail",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/pin/set?pin=12",
              "query": [{ "key": "pin", "value": "12" }]
            }
          }
        },
        {
          "name": "Set PIN 1234",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/pin/set?pin=1234",
              "query": [{ "key": "pin", "value": "1234" }]
            }
          }
        },
        {
          "name": "Verify Correct PIN â€” Expect Success",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNo}}/pin/verify?pin=1234",
