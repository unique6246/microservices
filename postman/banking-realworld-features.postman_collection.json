            }
          }
        }
      ]
    },
    {
      "name": "06 â€” KYC Document Management",
      "item": [
        {
          "name": "Upload Aadhaar Document",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var body = pm.response.json();",
              "if (body.id) pm.collectionVariables.set('docId', body.id);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/kyc/documents/upload",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"documentType\": \"AADHAAR\",\n  \"documentNumber\": \"1234-5678-9012\",\n  \"documentUrl\": \"/docs/aadhaar-1.jpg\"\n}"
            }
          }
        },
        {
          "name": "Upload PAN Document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/kyc/documents/upload",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"documentType\": \"PAN\",\n  \"documentNumber\": \"ABCDE1234F\",\n  \"documentUrl\": \"/docs/pan-1.jpg\"\n}"
            }
          }
        },
        {
          "name": "Check KYC Status (expect UNDER_REVIEW)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/kyc/{{customerId}}/status"
          }
        },
        {
          "name": "Admin: Verify Aadhaar",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/kyc/documents/{{docId}}/review?status=VERIFIED",
              "query": [{ "key": "status", "value": "VERIFIED" }]
            }
          }
        },
        {
          "name": "Admin: Verify PAN (triggers VERIFIED status)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/kyc/documents/2/review?status=VERIFIED",
              "query": [{ "key": "status", "value": "VERIFIED" }]
            }
          }
        },
        {
          "name": "Check KYC Status (expect VERIFIED)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/kyc/{{customerId}}/status"
          }
        },
        {
          "name": "Admin: Reject Document",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/kyc/documents/3/review?status=REJECTED&rejectionReason=Blurry+image",
              "query": [
                { "key": "status", "value": "REJECTED" },
                { "key": "rejectionReason", "value": "Blurry image" }
              ]
            }
          }
        },
        {
          "name": "Get All KYC Documents for Customer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/kyc/{{customerId}}/documents"
          }
        }
      ]
    },
    {
      "name": "07 â€” OTP",
      "item": [
        {
          "name": "Generate OTP â€” TRANSACTION_AUTH",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var body = pm.response.json();",
              "if (body.otp) pm.collectionVariables.set('otp', body.otp);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"purpose\": \"TRANSACTION_AUTH\"\n}"
            }
          }
        },
        {
          "name": "Verify Correct OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"otp\": \"{{otp}}\",\n  \"purpose\": \"TRANSACTION_AUTH\"\n}"
            }
          }
        },
        {
          "name": "Verify Used OTP â€” Expect Fail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"otp\": \"{{otp}}\",\n  \"purpose\": \"TRANSACTION_AUTH\"\n}"
            }
          }
        },
        {
          "name": "Generate OTP â€” TPIN_RESET",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"purpose\": \"TPIN_RESET\"\n}"
            }
          }
        },
        {
          "name": "Verify Wrong OTP (attempt 1 of 3)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"otp\": \"000000\",\n  \"purpose\": \"TPIN_RESET\"\n}"
            }
          }
        }
      ]
    },
    {
